# --- Twitch ---
# Имя бот-аккаунта (можно использовать и аккаунт самого стримера)
TWITCH_BOT_USERNAME=your_bot_account

# OAuth-токен бота. Получить: https://twitchapps.com/tmi/ (формат "oauth:xxxxxxxx")
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Канал, в чат которого подключаемся (без #, в нижнем регистре)
TWITCH_CHANNEL=your_channel

# --- Доступ к команде ---
# Кто может вызывать !qr: everyone | mods | broadcaster
QR_COMMAND_PERMISSION=mods

# Кулдаун между вызовами команды, в секундах
QR_COMMAND_COOLDOWN=15

# --- Сервер для OBS Browser Source ---
PORT=8123

# Сколько секунд оверлей виден на экране перед тем как спрятаться
OVERLAY_DISPLAY_SECONDS=12
